{
  "name": "dota2-match-notes",
  "version": "3.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w @dota-notes/web",
    "build": "npm run build -w @dota-notes/web",
    "start": "npm run start -w @dota-notes/web",
    "test": "npm run test -w @dota-notes/web && vitest run",
    "stratz:route-check": "npm run stratz:route-check -w @dota-notes/web",
    "heroes:sync": "npm run heroes:sync -w @dota-notes/web",
    "items:sync": "npm run items:sync -w @dota-notes/web",
    "inventory:frames": "npm run inventory:frames -w @dota-notes/web",
    "db:generate": "npm run db:generate -w @dota-notes/web",
    "db:migrate": "npm run db:migrate -w @dota-notes/web",
    "db:studio": "npm run db:studio -w @dota-notes/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web:dev": "npm run dev -w @dota-notes/web",
    "desktop:dev": "npm run dev -w @dota-notes/desktop",
    "desktop:build": "npm run build -w @dota-notes/desktop",
    "desktop:tauri": "npm run tauri -w @dota-notes/desktop -- dev",
    "desktop:bundle": "npm run tauri -w @dota-notes/desktop -- build",
    "api:dev": "npm run dev -w @dota-notes/api",
    "api:build": "npm run build -w @dota-notes/api",
    "api:start": "npm run start -w @dota-notes/api",
    "mobile:dev": "npm run start -w @dota-notes/mobile",
    "mobile:android": "npm run android -w @dota-notes/mobile",
    "mobile:ios": "npm run ios -w @dota-notes/mobile"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  }
}
