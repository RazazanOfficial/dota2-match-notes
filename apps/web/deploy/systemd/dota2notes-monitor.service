[Unit]
Description=Capture read-only Dota2 Notes service status and recent logs
After=systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/dota2notes-monitor.conf
ExecStart=/usr/bin/node /usr/local/libexec/dota2notes/collect.mjs
UMask=0027
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dota2notes/monitor
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
MemoryMax=128M

