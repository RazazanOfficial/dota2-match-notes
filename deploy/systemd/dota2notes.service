[Unit]
Description=Dota2 Notes Next.js application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dota2notes
Group=dota2notes
WorkingDirectory=/var/www/dota2notes
EnvironmentFile=/var/www/dota2notes/.env.production
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStartPre=/usr/bin/test -f /var/www/dota2notes/.next/BUILD_ID
ExecStart=/usr/bin/node /var/www/dota2notes/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/dota2notes/.next
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=1536M
MemoryMax=2048M
TasksMax=256

[Install]
WantedBy=multi-user.target
