[Unit]
Description=Dota Notes continuous requested-match sync worker
After=network-online.target dota2notes-link.service dota2notes-api.service
Requires=dota2notes-link.service
Wants=network-online.target
[Service]
Type=simple
User=dota2notes
Group=dota2notes
WorkingDirectory=/var/www/dota2notes/apps/api/release
EnvironmentFile=/var/www/dota2notes/.env.production
ExecStartPre=/usr/bin/node /var/www/dota2notes/apps/api/release/dist/preflight.js --role=sync
ExecStart=/usr/bin/node /var/www/dota2notes/apps/api/release/dist/worker.js sync --watch
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=384M
MemoryMax=768M
CPUQuota=100%
[Install]
WantedBy=multi-user.target
