[Unit]
Description=Dota2 Notes replay pipeline (2 transfers, 1 parser, 1 archive)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
User=dota2notes
Group=dota2notes
WorkingDirectory=/var/www/dota2notes
EnvironmentFile=/var/www/dota2notes/.env.production
ExecStartPre=/usr/bin/node /var/www/dota2notes/apps/api/release/dist/preflight.js --role=replay
ExecStart=/usr/bin/node /var/www/dota2notes/apps/api/release/scripts/replay-parser/run-pipeline.mjs
TimeoutStartSec=60s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dota2notes/replays
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=1700M
MemoryMax=2100M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
