# Merge with the private Iran env; do not replace secrets with placeholders.
DOTA_NODE_ROLE=app
DOTA_COMPUTE_ORIGIN=http://127.0.0.1:14100
DOTA_COMPUTE_TOKEN=YOUR_SHARED_RANDOM_BASE64URL_TOKEN
DOTA_COMPUTE_TIMEOUT_MS=180000
DATABASE_URL=postgresql://dota_notes_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/dota_notes_primary
API_HOST=127.0.0.1
API_PORT=4100
API_PUBLIC_ORIGIN=https://api.dota2notes.ir
APP_URL=https://dota2notes.ir
API_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
API_TRUST_PROXY=127.0.0.1,::1
LOCAL_REPLAY_WORKER_ENABLED=false
SCHEDULED_SYNC_ENABLED=off
OPENDOTA_PARSE_ENABLED=false
# Keep SUPER_ADMIN_STEAM_IDS, SYNC_WORKER_SECRET and account policies consistent.
# Merge CLOUD_SPACE_* from env.production.example for private signed downloads.
# Iran needs GetObject/HeadObject; Steam, STRATZ and email credentials stay Germany.
