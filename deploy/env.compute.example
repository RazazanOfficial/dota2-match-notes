# Merge with the private Germany env. There is one authoritative DB in Iran.
DOTA_NODE_ROLE=compute
DOTA_COMPUTE_TOKEN=YOUR_SHARED_RANDOM_BASE64URL_TOKEN
DOTA_COMPUTE_TIMEOUT_MS=180000
DATABASE_URL=postgresql://dota_notes_compute:URL_ENCODED_PASSWORD@127.0.0.1:15432/dota_notes_primary
API_HOST=127.0.0.1
API_PORT=4100
API_PUBLIC_ORIGIN=https://api.dota2notes.ir
APP_URL=https://dota2notes.ir
API_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
API_TRUST_PROXY=127.0.0.1,::1
LOCAL_REPLAY_WORKER_ENABLED=true
LOCAL_REPLAY_DOWNLOAD_MODE=direct
LOCAL_REPLAY_PREPARE_CONCURRENCY=2
LOCAL_REPLAY_PARSE_CONCURRENCY=2
LOCAL_REPLAY_ARCHIVE_CONCURRENCY=1
REPLAY_PARSER_JAR=/var/lib/dota2notes/parser/parser.jar
LOCAL_REPLAY_INCOMING_DIR=/var/lib/dota2notes/replays/incoming
LOCAL_REPLAY_SPOOL_CAP_MIB=4096
SCHEDULED_SYNC_ENABLED=off
OPENDOTA_PARSE_ENABLED=false
STRATZ_ROUTING=dns
STRATZ_TRANSPORT=node
# Keep STEAM_WEB_API_KEY, STRATZ_API_TOKEN, RESEND_API_KEY, AUTH_EMAIL_FROM,
# CLOUD_SPACE_* and the existing bounded worker policies on this host.
# GC, Telegram and automatic match detection are separate future features.
