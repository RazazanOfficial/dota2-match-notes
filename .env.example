# Public origin used for Steam OpenID callbacks. Do not add a trailing slash.
APP_URL=http://localhost:3000

# Server-only Steam Web API key. Leave blank to use fallback profile details.
STEAM_WEB_API_KEY=

# PostgreSQL connection used by Next.js and Drizzle Kit.
# Copy this file to .env.local and replace CHANGE_ME locally.
DATABASE_URL=postgresql://dota_notes_app:CHANGE_ME@127.0.0.1:5432/dota_notes

# ParsPack S3-compatible object storage. These values remain server-only.
CLOUD_SPACE_END_POINT_URL=https://YOUR_ENDPOINT
CLOUD_SPACE_BUCKET=YOUR_BUCKET
CLOUD_SPACE_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET_ROOT
CLOUD_SPACE_ACCESS_KEY=YOUR_ACCESS_KEY
CLOUD_SPACE_SECRET_KEY=YOUR_SECRET_KEY
CLOUD_SPACE_REGION=us-east-1
CLOUD_SPACE_FORCE_PATH_STYLE=true

# Safety limit for each image generated by the backend (12 MiB by default).
GENERATED_IMAGE_MAX_BYTES=12582912
