# Public origin used for Steam OpenID callbacks. Do not add a trailing slash.
APP_URL=http://localhost:3000

# Server-only Steam Web API key. Leave blank to use fallback profile details.
STEAM_WEB_API_KEY=

# PostgreSQL connection used by Next.js and Drizzle Kit.
# Copy this file to .env.local and replace CHANGE_ME locally.
DATABASE_URL=postgresql://dota_notes_app:CHANGE_ME@127.0.0.1:5432/dota_notes
